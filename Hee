local function GetClosestPlayerToCenter()
    local Target = nil
    local ShortestDistance = math.huge
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, v in pairs(Players:GetPlayers()) do  
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then  
            local Pos, OnScreen = Camera:WorldToViewportPoint(v.Character.Head.Position)  
            if OnScreen then  
                local Dist = (CenterScreen - Vector2.new(Pos.X, Pos.Y)).Magnitude  
                if Dist < ShortestDistance and Dist <= (Config.FovRadius * 4) then  
                    Target = v  
                    ShortestDistance = Dist  
                end  
            end  
        end  
    end  
    return Target
end

-- [ฟังก์ชันแก้ไขใหม่] ระบบส่งคำสั่งคลิกยิงตรงพิกัดเป้าเล็งกลางหน้าจอ
local function TriggerShoot()
    if (tick() - lastShootTime) >= 0.05 then
        lastShootTime = tick()
        task.spawn(function()
            local CenterX = Camera.ViewportSize.X / 2
            local CenterY = Camera.ViewportSize.Y / 2
            -- ส่งพิกัดกึ่งกลางจอลงใน Input เพื่อสั่งยิงให้ตรงเป้าเล็งแบบแม่นยำ 100%
            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, true, game, 1)
            task.wait(0.03) -- หน่วงเวลาเล็กน้อยให้ระบบเกมรับข้อมูลทัน
            VirtualInputManager:SendMouseButtonEvent(CenterX, CenterY, 0, false, game, 1)
        end)
    end
end

-- ระบบลูปควบคุม (RenderStepped & Heartbeat) 
RunService.RenderStepped:Connect(function()
    local CenterScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Config.FovRadius * 4
    FOVCircle.Visible = true
    FOVCircle.Position = CenterScreen

    -- ฟังก์ชัน วาปเกาะติดศัตรู
    if IsFollowing then
        local function GetClosestEnemy()
            local Target = nil
            local ShortestDistance = math.huge
            local MyChar = LocalPlayer.Character
            if not MyChar then return nil end
            local MyHRP = MyChar:FindFirstChild("HumanoidRootPart")
            if not MyHRP then return nil end
            local MyPos = MyHRP.Position

            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") then
                    if v.Character.Humanoid.Health > 0 then
                        if v.Team and LocalPlayer.Team and v.Team == LocalPlayer.Team then
                            continue
                        end
                        
                        local Dist = (v.Character.HumanoidRootPart.Position - MyPos).Magnitude
                        if Dist < ShortestDistance then
                            Target = v
                            ShortestDistance = Dist
                        end
                    end
                end
            end
            return Target
        end

        if not TargetPlayer or not TargetPlayer.Character or not TargetPlayer.Character:FindFirstChild("Humanoid") or TargetPlayer.Character.Humanoid.Health <= 0 or not TargetPlayer.Parent then
            TargetPlayer = GetClosestEnemy()
        end

        if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("Head") then
            local MyChar = LocalPlayer.Character
            if MyChar then
                local MyHRP = MyChar:FindFirstChild("HumanoidRootPart")
                if MyHRP then
                    for _, part in pairs(MyChar:GetChildren()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                    MyHRP.CFrame = TargetPlayer.Character.Head.CFrame + Vector3.new(0, TeleportHeight, 0)
                    MyHRP.Velocity = Vector3.new(0, 0, 0)
                    
                    -- เรียกใช้ฟังก์ชันยิงอัตโนมัติที่ได้รับการแก้ไขแล้วเมื่อบินค้าง
                    if Config.AutoShoot then
                        TriggerShoot()
                    end
                end
            end
        else
            TargetPlayer = nil
        end
    end

    -- ฟังก์ชัน Aim ปกติของเมนูหลัก
    if (Config.Aim or Config.AimTorso) and not IsFollowing then  
        local Target = GetClosestPlayerToCenter()  
        if Target and Target.Character then  
            local MyHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")  
            if MyHRP then  
                local LockPart = nil  
                if Config.Aim and Target.Character:FindFirstChild("Head") then  
                    LockPart = Target.Character.Head  
                elseif Config.AimTorso and Target.Character:FindFirstChild("HumanoidRootPart") then  
                    LockPart = Target.Character.HumanoidRootPart  
                end  
                  
                if LockPart then  
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, LockPart.Position)  
                    MyHRP.CFrame = CFrame.new(MyHRP.Position, Vector3.new(LockPart.Position.X, MyHRP.Position.Y, LockPart.Position.Z))  
                    
                    -- เรียกใช้ฟังก์ชันยิงอัตโนมัติที่แก้ไขแล้วเมื่อ Aim ล็อคเป้าหมายเรียบร้อย
                    if Config.AutoShoot then  
                        TriggerShoot()
                    end  
                end  
            end  
        end  
    end  
      
    -- วาดภาพ ESP
    for player, drawings in pairs(ESPCache) do  
        if player and player.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then  
            local Char = player.Character  
            local HRP = Char.HumanoidRootPart  
            local Head = Char.Head  
            local Hum = Char.Humanoid  
              
            local HeadCFrame = Head.CFrame  
            local TopPos, TopOnScreen = Camera:WorldToViewportPoint(HeadCFrame.Position + Vector3.new(0, 1.2, 0))  
            local BottomPos, BottomOnScreen = Camera:WorldToViewportPoint(HRP.Position - Vector3.new(0, 3, 0))  
              
            local hue = (tick() % 5) / 5  
            local rainbowColor = Color3.fromHSV(hue, 1, 1)  
              
            if TopOnScreen and BottomOnScreen then  
                local BoxHeight = math.abs(TopPos.Y - BottomPos.Y)  
                local BoxWidth = BoxHeight * 0.65  
                local BoxX = TopPos.X - (BoxWidth / 2)  
                local BoxY = TopPos.Y  
                  
                if Config.EspBox then  
                    drawings.Box.Size = Vector2.new(BoxWidth, BoxHeight)  
                    drawings.Box.Position = Vector2.new(BoxX, BoxY)  
                    drawings.Box.Color = rainbowColor  
                    drawings.Box.Visible = true  
                else  
                    drawings.Box.Visible = false  
                end  
                  
                if Config.EspHealth then  
                    drawings.HealthBg.From = Vector2.new(BoxX - 5, BoxY)  
                    drawings.HealthBg.To = Vector2.new(BoxX - 5, BoxY + BoxHeight)  
                    drawings.HealthBg.Visible = true  
                      
                    local healthPercentage = math.clamp(Hum.Health / Hum.MaxHealth, 0, 1)  
                    drawings.HealthLine.From = Vector2.new(BoxX - 5, BoxY + BoxHeight)  
                    drawings.HealthLine.To = Vector2.new(BoxX - 5, BoxY + BoxHeight - (BoxHeight * healthPercentage))  
                    drawings.HealthLine.Visible = true  
                else  
                    drawings.HealthBg.Visible = false  
                    drawings.HealthLine.Visible = false  
                end  
                  
                if Config.EspLine then  
                    local HeadPos, HeadOnScreen = Camera:WorldToViewportPoint(Head.Position)  
                    if HeadOnScreen then  
                        drawings.Line.From = Vector2.new(Camera.ViewportSize.X / 2, 0)  
                        drawings.Line.To = Vector2.new(HeadPos.X, HeadPos.Y)  
                        drawings.Line.Color = rainbowColor  
                        drawings.Line.Visible = true  
                    else  
                        drawings.Line.Visible = false  
                    end  
                else  
                    drawings.Line.Visible = false  
                end  
            else  
                drawings.Box.Visible = false  
                drawings.HealthBg.Visible = false  
                drawings.HealthLine.Visible = false  
                drawings.Line.Visible = false  
            end  
        else  
            drawings.Box.Visible = false  
            drawings.HealthBg.Visible = false  
            drawings.HealthLine.Visible = false  
            drawings.Line.Visible = false  
        end  
    end
end)

-- ระบบจัดการสร้างและลบสารบัญข้อมูล ESP
local function CreateESP(player)
    if ESPCache[player] then return end
    local box = Drawing.new("Square")  
    box.Thickness = 2  
    box.Filled = false  
    box.Visible = false  
    local healthBg = Drawing.new("Line")  
    healthBg.Thickness = 2  
    healthBg.Color = Color3.fromRGB(50, 0, 0)  
    healthBg.Visible = false  
    local healthLine = Drawing.new("Line")  
    healthLine.Thickness = 2  
    healthLine.Color = Color3.fromRGB(0, 255, 0)  
    healthLine.Visible = false  
    local line = Drawing.new("Line")  
    line.Thickness = 2  
    line.Visible = false  
    ESPCache[player] = {Box = box, HealthBg = healthBg, HealthLine = healthLine, Line = line}
end

local function RemoveESP(player)
    if ESPCache[player] then
        for _, drawing in pairs(ESPCache[player]) do
            drawing.Visible = false
            drawing:Delete()
        end
        ESPCache[player] = nil
    end
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateESP(p) end
end

