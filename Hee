local function ApplyRainbow(object, property)
    task.spawn(function()
        while task.wait() do
            local hue = (tick() % 5) / 5
            local color = Color3.fromHSV(hue, 1, 1)
            pcall(function() object[property] = color end)
        end
    end)
end

